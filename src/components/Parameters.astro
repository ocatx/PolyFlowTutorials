---
import 'katex/dist/katex.min.css';
import katex from 'katex';

const parameters = [
  {
    label: "Viscosity (μ)",
    formula: "10^{5} \\, \\text{Pa·s}"
  },
  {
    label: "Density (ρ)",
    formula: "10^{-3} \\, \\text{g/mm}^3"
  },
  {
    label: "Initial thickness (h_0)",
    formula: "0.35 \\, \\text{mm}"
  },
  {
    label: "Pressure (P)",
    formula: "10^{5} \\, \\text{Pa}"
  },
  {
    label: "Coefficient of permeability (k)",
    formula: "5 \\times 10^{-12} \\, \\text{g·mm/s/mm}^2"
  },
];
---

<div class="parameters-section">
  <h2>Simulation Parameters</h2>
  
  <div class="params-grid">
    {parameters.map(param => {
      const html = katex.renderToString(param.formula, {
        throwOnError: false,
        displayMode: false
      });
      
      return (
        <div class="param-item">
          <strong>{param.label}:</strong>
          <span set:html={html} />
        </div>
      );
    })}
  </div>
</div>

<style>
  .parameters-section {
    margin: 2.5rem 0;
    padding: 2rem;
    background: #1a1a1a;
    border-radius: 12px;
    border: 1px solid #333;
  }

  .params-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .param-item {
    background: #252525;
    padding: 1.2rem;
    border-radius: 10px;
    line-height: 1.6;
  }

  strong {
    color: #4fc3f7;
    display: block;
    margin-bottom: 0.5rem;
  }
</style>