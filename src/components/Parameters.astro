---
import 'katex/dist/katex.min.css';
import { InlineMath, BlockMath } from 'katex-react';

interface Props {
  title?: string;
}

const { title = "Simulation Parameters" } = Astro.props;
---

<div class="parameters-section">
  <h2>{title}</h2>
  
  <div class="params-grid">
    <div class="param-item">
      <strong>Viscosity (μ):</strong>
      <InlineMath math="10^5 \, \text{Pa·s}" />
    </div>

    <div class="param-item">
      <strong>Density (ρ):</strong>
      <InlineMath math="10^{-3} \, \text{g/mm}^3" />
    </div>

    <div class="param-item">
      <strong>Initial thickness (h₀):</strong>
      <InlineMath math="0.35 \, \text{mm}" />
    </div>

    <div class="param-item">
      <strong>Pressure (P):</strong>
      <InlineMath math="10^5 \, \text{Pa}" />
    </div>

    <div class="param-item">
      <strong>Coefficient of permeability (k):</strong>
      <InlineMath math="5 \times 10^{-12} \, \text{g·mm/s/mm}^2" />
    </div>
  </div>
</div>

<style>
  .parameters-section {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: #1a1a1a;
    border-radius: 12px;
  }

  .params-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .param-item {
    background: #252525;
    padding: 1rem;
    border-radius: 8px;
  }

  strong {
    color: #4fc3f7;
    display: block;
    margin-bottom: 0.4rem;
  }
</style>